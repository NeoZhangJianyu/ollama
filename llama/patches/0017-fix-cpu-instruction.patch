From: Neo Zhang Jianyu <zhang.jianyu@outlook.com>
Date: Sat, 14 Jun 2025 10:49:34 +0800
Subject: [PATCH] fix cpu instruction

---
 ggml/src/CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ggml/src/CMakeLists.txt b/ggml/src/CMakeLists.txt
index 0beaed86..79957b53 100644
--- a/ggml/src/CMakeLists.txt
+++ b/ggml/src/CMakeLists.txt
@@ -294,8 +294,8 @@ if (GGML_CPU_ALL_VARIANTS)
     ggml_add_cpu_backend_variant(sandybridge  SSE42 AVX)
     ggml_add_cpu_backend_variant(haswell      SSE42 AVX F16C AVX2 BMI2 FMA)
     ggml_add_cpu_backend_variant(skylakex     SSE42 AVX F16C AVX2 BMI2 FMA AVX512)
-    ggml_add_cpu_backend_variant(icelake      SSE42 AVX F16C AVX2 BMI2 FMA AVX512 AVX512_VBMI AVX512_VNNI)
-    ggml_add_cpu_backend_variant(alderlake    SSE42 AVX F16C AVX2 BMI2 FMA AVX_VNNI)
+    ggml_add_cpu_backend_variant(icelake      SSE42 AVX F16C AVX2 BMI2 FMA AVX512 AVX512_VBMI)
+    ggml_add_cpu_backend_variant(alderlake    SSE42 AVX F16C AVX2 BMI2 FMA)
 elseif (GGML_CPU)
     ggml_add_cpu_backend_variant_impl("")
 endif()
